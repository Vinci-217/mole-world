{
  "name": "mole-manor-world",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.manor.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --config vite.manor.config.ts && python3 scripts/stage_handmade_assets.py",
    "preview": "vite preview --config vite.manor.config.ts --host 0.0.0.0",
    "release": "npm run build && python3 scripts/package_handmade.py",
    "test": "python3 -m unittest discover -s tests -p test_handmade_world.py && playwright test --config playwright.manor.config.ts",
    "models:handmade": "blender -b --python-exit-code 1 --python scripts/build_handmade_world.py",
    "models:audit": "blender -b --python-exit-code 1 --python scripts/audit_handmade.py",
    "capture": "node scripts/capture_handmade.mjs",
    "publish": "python3 scripts/publish_handmade.py --push",
    "verify:live": "python3 scripts/verify_handmade_deployment.py"
  },
  "dependencies": {
    "lucide": "0.468.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.38.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.180.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
